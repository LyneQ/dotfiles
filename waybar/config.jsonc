{
  "position": "top",
  //	"margin": "8 16 0",
  "margin": "0",
  "mod": "dock",
  "modules-left": [
    "custom/logo",
    "hyprland/workspaces"
  ],
  "modules-center": [
  //"hyprland/window"
    "custom/media"
  ],
  "modules-right": [
    "tray",
    "custom/network",
    "custom/hw",
    "custom/spacer",
    "pulseaudio#source",
    "pulseaudio#sink",
    "custom/spacer",
    "clock",
    "custom/notification"
  ],
  "hyprland/window": {
    "format": "{}"
  },
  "custom/logo": {
    "return-type": "json",
    "exec": "$HOME/.config/waybar/scripts/distro_icon.sh",
    "interval": 3600,
    "tooltip": true,
    "on-click": "exec wlogout -b 4"
  },
  "hyprland/workspaces": {
    "format": "{icon}",
    "format-icons": {
      "1": " ",
      "2": " ",
      "3": " ",
      "default": " "
    },
    "persistent-workspaces": {
      "*": [
        1,
        2,
        3
      ]
    }
  },
  "custom/media": {
    "exec": "/usr/bin/env python3 $HOME/dotfiles/waybar/scripts/mediaplayer.py --player spotify",
    "return-type": "json",
    "tail": true,
    "interval": 0,
    "tooltip": false,
    "on-click": "playerctl -p spotify play-pause",
    "on-scroll-up": "playerctl -p spotify next",
    "on-scroll-down": "playerctl -p spotify previous"
  },
  "tray": {
    "icon-size": 18,
    "spacing": 10
  },
  "custom/network": {
    "exec": "$HOME/.config/waybar/scripts/net_status.sh",
    "return-type": "json",
    "interval": 5,
    "tooltip": true
  },
  "bluetooth": {
    "format": "󰂯",
    "format-disabled": "󰂲",
    "format-connected": "󰂱 {num_connections}",
    "tooltip-format": "{controller_alias}\n\n{num_connections} connected",
    "tooltip-format-connected": "{controller_alias}\n\n{num_connections} connected\n\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}",
    "on-click": "blueman-manager"
  },
  "custom/hw": {
    "exec": "$HOME/.config/waybar/scripts/hw_info.sh",
    "format": "{}",
    "return-type": "json",
    "interval": 5,
    "tooltip": true
  },
  "pulseaudio#source": {
    "format": "{format_source}",
    "format-source": "",
    "format-source-muted": " ",
    "on-click": "wpctl set-mute @DEFAULT_SOURCE@ toggle",
    "on-click-right": "pwvucontrol",
    "on-scroll-up": "wpctl set-volume -l 1.3 @DEFAULT_SOURCE@ 5%+",
    "on-scroll-down": "wpctl set-volume -l 1.3 @DEFAULT_SOURCE@ 5%-",
    "scroll-step": 5
  },
  "pulseaudio#sink": {
    "format": "{icon} {volume}%",
    "format-muted": "󰖁 {volume}%",
    "on-click": "wpctl set-mute @DEFAULT_SINK@ toggle",
    "on-click-right": "pwvucontrol",
    "on-scroll-up": "wpctl set-volume -l 1.3 @DEFAULT_SINK@ 5%+",
    "on-scroll-down": "wpctl set-volume @DEFAULT_SINK@ 5%-",
    "scroll-step": 5,
    "format-icons": {
      "headphone": "",
      "hands-free": "",
      "headset": "",
      "default": [
        "",
        ""
      ]
    }
  },
  "clock": {
    "format": "{:%R %a %m/%d}",
    "tooltip-format": "{calendar}",
    "calendar": {
      "format": {
        "months": "<span color='#f50a1c'><b>{}</b></span>",
        "days": "<span color='white'><b>{}</b></span>",
        "weekdays": "<span color='white'><b>{}</b></span>",
        "today": "<span color='#f50a1c'><b><u>{}</u></b></span>"
      }
    }
  },
  "custom/notification": {
    "tooltip": false,
    "format": "{icon}",
    "format-icons": {
      "notification": "<span foreground='red'><sup></sup></span>",
      "none": "",
      "dnd-notification": "<span foreground='red'><sup></sup></span>",
      "dnd-none": "",
      "inhibited-notification": "<span foreground='red'><sup></sup></span>",
      "inhibited-none": "",
      "dnd-inhibited-notification": "<span foreground='red'><sup></sup></span>",
      "dnd-inhibited-none": ""
    },
    "return-type": "json",
    "exec-if": "which swaync-client",
    "exec": "swaync-client -swb",
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "escape": true
  },
  "custom/spacer": {
    "format": " | ",
    "tooltip": false
  }
}
